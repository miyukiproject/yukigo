    "@types/moo": "^0.5.10",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "moo": "^0.5.2",
    "moo-ignore": "^2.5.3",
    "nearley": "^2.20.1"
  },
  "peerDependencies": {
    "yukigo-ast": "^0.3.6"
  }
