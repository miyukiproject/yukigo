{
  "name": "yukigo-prolog-parser",
  "version": "0.2.6",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "unpkg": "dist/bundle.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "nearleyc ./src/parser/grammar.ne -o ./src/parser/grammar.cjs && tsc && esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/bundle.js && esbuild src/index.ts --bundle --format=iife --global-name=YukigoPrologParser --target=es2022 --outfile=dist/bundle.iife.js",
    "test": "mocha --import=tsx"
  },
  "keywords": [],
  "author": "noiseArch",
  "license": "ISC",
  "dependencies": {
    "moo": "^0.5.2",
    "moo-ignore": "^2.5.3",
    "nearley": "^2.20.1"
  },
  "devDependencies": {
    "@types/moo": "^0.5.10"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./bundle": "./dist/bundle.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "yukigo-ast": "^0.3.5"
  }
}