{
  "name": "yukigo-haskell-parser",
  "version": "0.2.7",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "unpkg": "dist/bundle.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./bundle": "./dist/bundle.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "compile:grammar": "nearleyc ./src/parser/grammar.ne -o ./src/parser/grammar.cjs",
    "build": "npm run compile:grammar && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/bundle.js && esbuild src/index.ts --bundle --format=iife --global-name=YukigoHaskellParser --target=es2022 --outfile=dist/bundle.iife.js",
    "test": "mocha --import=tsx"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/moo": "^0.5.10",
    "@types/nearley": "^2.11.5"
  },
  "peerDependencies": {
    "yukigo-ast": "^0.3.6"
  },
  "dependencies": {
    "moo": "^0.5.2",
    "moo-ignore": "^2.5.3",
    "moo-indentation-lexer": "^6.0.0",
    "nearley": "^2.20.1"
  }
}